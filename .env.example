# OpenDataGuard Runtime Environment Configuration

# Custom path to SQLite validation history database (optional)
# Defaults to ~/.opendataguard/history.db if omitted
OPENDATAGUARD_HISTORY_DB=./history.db

# Maximum upload file size limit in bytes (defaults to 104857600 -> 100MB)
OPENDATAGUARD_MAX_UPLOAD_BYTES=104857600

# Optional PostgreSQL Connection (Leave empty if using local SQLite)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=analytics_warehouse
# DB_USER=readonly_auditor
# DB_PASSWORD=your_secure_password_here
